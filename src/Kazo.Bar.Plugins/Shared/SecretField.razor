@namespace Kazo.Bar.Plugins.Shared
@using Kazo.Bar.Core.Interfaces
@implements IDisposable
@inject IServiceProvider Services

@* US2.4: a token is typed once, saved in the secret store, and never shown again.
   With SignInWith, the user can sign in with OAuth (device flow) instead of pasting a token. *@
<div class="secret-field" data-testid="secret-field">
    <span class="secret-field-label">@Label</span>
    @if (_store == null)
    {
        <span class="plugin-settings-hint">No secret store in this host.</span>
    }
    else if (_challenge != null)
    {
        <div class="secret-field-device" data-testid="secret-field-device" role="status">
            Open <a href="@_challenge.VerificationUri" target="_blank" rel="noopener noreferrer">@_challenge.VerificationUri.Host@_challenge.VerificationUri.AbsolutePath</a>
            and enter the code <code class="secret-field-code" data-testid="secret-field-code">@_challenge.UserCode</code>.
            <span class="plugin-settings-hint">Waiting for approval…</span>
            <button type="button" class="plugin-settings-icon-btn" title="Cancel the sign-in" @onclick="CancelSignIn">↩</button>
        </div>
    }
    else if (_saved && !_editing)
    {
        @if (_kind == StoredCredentialKind.OAuth)
        {
            <span class="secret-field-saved" data-testid="secret-field-signed-in">✓ Signed in with @ProviderName</span>
        }
        else
        {
            <span class="secret-field-saved" data-testid="secret-field-saved">●●●●●●●● saved</span>
        }
        <button type="button" class="plugin-settings-icon-btn secret-field-replace" title="Replace the token" @onclick="() => _editing = true">✎</button>
        <button type="button" class="plugin-settings-icon-btn secret-field-remove" title="Remove the token" @onclick="RemoveAsync">✕</button>
    }
    else
    {
        <input type="password" class="secret-field-input" data-testid="secret-field-input" autocomplete="off"
               placeholder="@Placeholder" @bind="_value" @bind:event="oninput" />
        <button type="button" class="plugin-settings-primary secret-field-save" data-testid="secret-field-save"
                disabled="@string.IsNullOrWhiteSpace(_value)" @onclick="SaveAsync">Save token</button>
        @if (_saved)
        {
            <button type="button" class="plugin-settings-icon-btn" title="Keep the saved token" @onclick="Cancel">↩</button>
        }
        @if (SignInWith is { } provider && _signIn != null)
        {
            var configured = _signIn.IsConfigured(provider);
            <span class="secret-field-or">or</span>
            <button type="button" class="plugin-settings-primary secret-field-signin" data-testid="secret-field-signin"
                    disabled="@(!configured)" @onclick="SignInAsync">Sign in with @ProviderName</button>
            @if (!configured)
            {
                <span class="plugin-settings-hint" data-testid="secret-field-signin-hint">Add the client ID of your @AppName in Settings → Sign-in apps to sign in.</span>
            }
        }
    }
    @if (_error != null)
    {
        <div class="plugin-settings-error" role="alert">@_error</div>
    }
</div>

@code {
    /// <summary>Reference the token is stored under (never the token itself).</summary>
    [Parameter, EditorRequired] public string SecretRef { get; set; } = string.Empty;

    [Parameter] public string Label { get; set; } = "Access token";

    [Parameter] public string Placeholder { get; set; } = "Paste a personal access token";

    /// <summary>Offers "Sign in with …" (OAuth device flow) next to the token box when the host supports it.</summary>
    [Parameter] public OAuthProvider? SignInWith { get; set; }

    private ISecretStore? _store;
    private IOAuthSignInService? _signIn;
    private StoredCredentialKind _kind;
    private DeviceCodeChallenge? _challenge;
    private CancellationTokenSource? _signInCancel;

    private string ProviderName => SignInWith == OAuthProvider.AzureDevOps ? "Microsoft" : "GitHub";
    private string AppName => SignInWith == OAuthProvider.AzureDevOps ? "Microsoft Entra app" : "GitHub OAuth app";
    private string? _loadedRef;
    private bool _saved;
    private bool _editing;
    private string _value = string.Empty;
    private string? _error;

    protected override void OnInitialized()
    {
        _store = Services.GetService(typeof(ISecretStore)) as ISecretStore;
        _signIn = Services.GetService(typeof(IOAuthSignInService)) as IOAuthSignInService;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_store == null || _loadedRef == SecretRef)
            return;
        _loadedRef = SecretRef;
        _editing = false;
        _value = string.Empty;
        CancelSignIn();
        try
        {
            _saved = !string.IsNullOrEmpty(SecretRef) && (await _store.ListAsync()).Contains(SecretRef);
            _kind = await DescribeAsync();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"The secret store cannot be read: {ex.Message}";
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            await _store!.SetAsync(SecretRef, _value.Trim());
            _saved = true;
            _kind = StoredCredentialKind.PersonalAccessToken;
            _editing = false;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"The token could not be saved: {ex.Message}";
        }
        finally
        {
            _value = string.Empty;
        }
    }

    private async Task RemoveAsync()
    {
        try
        {
            await _store!.DeleteAsync(SecretRef);
            _saved = false;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"The token could not be removed: {ex.Message}";
        }
    }

    private void Cancel()
    {
        _editing = false;
        _value = string.Empty;
    }

    private async Task<StoredCredentialKind> DescribeAsync() =>
        !_saved ? StoredCredentialKind.None
        : _signIn != null ? await _signIn.DescribeAsync(SecretRef)
        : StoredCredentialKind.PersonalAccessToken;

    private async Task SignInAsync()
    {
        if (SignInWith is not { } provider || _signIn == null)
            return;
        CancelSignIn();
        var cancel = new CancellationTokenSource();
        _signInCancel = cancel;
        _error = null;
        try
        {
            _challenge = await _signIn.StartAsync(provider, cancel.Token);
        }
        catch (Exception ex)
        {
            if (ex is not OperationCanceledException)
                _error = ex.Message;
            if (ReferenceEquals(_signInCancel, cancel))
                CancelSignIn();
            return;
        }
        _ = WaitForApprovalAsync(_challenge, cancel);
    }

    /// <summary>Runs while the user approves the code in the browser; the field stays usable.</summary>
    private async Task WaitForApprovalAsync(DeviceCodeChallenge challenge, CancellationTokenSource cancel)
    {
        try
        {
            await _signIn!.CompleteAsync(challenge, SecretRef, cancel.Token);
            _saved = true;
            _editing = false;
            _kind = StoredCredentialKind.OAuth;
            _error = null;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        if (ReferenceEquals(_signInCancel, cancel))
        {
            _challenge = null;
            _signInCancel = null;
            cancel.Dispose();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void CancelSignIn()
    {
        var cancel = _signInCancel;
        _signInCancel = null;
        _challenge = null;
        if (cancel != null)
        {
            cancel.Cancel();
            cancel.Dispose();
        }
    }

    public void Dispose() => CancelSignIn();
}
