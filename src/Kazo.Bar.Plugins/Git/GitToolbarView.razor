@namespace Kazo.Bar.Plugins.Git
@using Kazo.Bar.UI.Components
@implements IDisposable

@*
    Git module (US5.1, US5.6). Glued to the right of the project pill, which shows the
    repository, branch and worktree (GitPillInfo). The module only holds the sync buttons:
    Pull, Push, and Pull & Push (icon only), plus the last sync message.
*@
<div class="plugin-git">
    <div class="git-sync">
        <button class="git-btn git-btn-pull" data-testid="git-pull" title="Pull latest changes" disabled="@Plugin.IsSyncing" @onclick="Plugin.PullAsync"><FaIcon Name="arrow-down" /><span class="git-btn-label"> Pull</span></button>
        <button class="git-btn git-btn-push" data-testid="git-push" title="Push local changes" disabled="@Plugin.IsSyncing" @onclick="Plugin.PushAsync"><FaIcon Name="arrow-up" /><span class="git-btn-label"> Push</span></button>
        <button class="git-btn git-btn-sync" data-testid="git-sync" title="Pull then push" aria-label="Pull then push" disabled="@Plugin.IsSyncing" @onclick="Plugin.PullAndPushAsync"><FaIcon Name="arrows-rotate" CssClass="@(Plugin.IsSyncing ? "fa-spin" : null)" /></button>
    </div>

    @if (!string.IsNullOrEmpty(Plugin.SyncStatus))
    {
        <div class="git-sync-status" title="@Plugin.SyncStatus">@Plugin.SyncStatus</div>
    }
</div>

@code {
    /// <summary>The plugin instance whose state is displayed.</summary>
    [Parameter, EditorRequired]
    public GitPlugin Plugin { get; set; } = default!;

    /// <summary>How often the branch and local changes are read again from the folder.</summary>
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(10);

    private GitPlugin? _subscribed;
    private Timer? _refreshTimer;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Plugin)) return;
        Unsubscribe();
        Plugin.OnStateChanged += OnPluginStateChanged;
        _subscribed = Plugin;
        _refreshTimer ??= new Timer(_ => _ = RefreshAsync(), null, RefreshInterval, RefreshInterval);
    }

    private async Task RefreshAsync()
    {
        try
        {
            await (_subscribed?.RefreshStatusAsync() ?? Task.CompletedTask);
        }
        catch (Exception)
        {
            // A failed background refresh keeps the last known state; the next tick retries.
        }
    }

    private void OnPluginStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void Unsubscribe()
    {
        if (_subscribed != null)
        {
            _subscribed.OnStateChanged -= OnPluginStateChanged;
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        Unsubscribe();
    }
}
