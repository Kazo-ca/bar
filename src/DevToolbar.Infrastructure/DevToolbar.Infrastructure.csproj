<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Real (non-simulated) services shared by the desktop hosts: versioned JSON
    storage in %APPDATA%\DevToolbar, the single user configuration file and its
    migrations. No UI and no host dependency, so it is unit-tested on Linux.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevToolbar.Core\DevToolbar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevToolbar.Tests.Unit" />
  </ItemGroup>

</Project>
