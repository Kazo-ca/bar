@namespace DevToolbar.Plugins.Shared
@using DevToolbar.Core.Interfaces
@inject IServiceProvider Services

@* US2.4: a token is typed once, saved in the secret store, and never shown again. *@
<div class="secret-field" data-testid="secret-field">
    <span class="secret-field-label">@Label</span>
    @if (_store == null)
    {
        <span class="plugin-settings-hint">No secret store in this host.</span>
    }
    else if (_saved && !_editing)
    {
        <span class="secret-field-saved" data-testid="secret-field-saved">●●●●●●●● saved</span>
        <button type="button" class="plugin-settings-icon-btn secret-field-replace" title="Replace the token" @onclick="() => _editing = true">✎</button>
        <button type="button" class="plugin-settings-icon-btn secret-field-remove" title="Remove the token" @onclick="RemoveAsync">✕</button>
    }
    else
    {
        <input type="password" class="secret-field-input" data-testid="secret-field-input" autocomplete="off"
               placeholder="@Placeholder" @bind="_value" @bind:event="oninput" />
        <button type="button" class="plugin-settings-primary secret-field-save" data-testid="secret-field-save"
                disabled="@string.IsNullOrWhiteSpace(_value)" @onclick="SaveAsync">Save token</button>
        @if (_saved)
        {
            <button type="button" class="plugin-settings-icon-btn" title="Keep the saved token" @onclick="Cancel">↩</button>
        }
    }
    @if (_error != null)
    {
        <div class="plugin-settings-error" role="alert">@_error</div>
    }
</div>

@code {
    /// <summary>Reference the token is stored under (never the token itself).</summary>
    [Parameter, EditorRequired] public string SecretRef { get; set; } = string.Empty;

    [Parameter] public string Label { get; set; } = "Access token";

    [Parameter] public string Placeholder { get; set; } = "Paste a personal access token";

    private ISecretStore? _store;
    private string? _loadedRef;
    private bool _saved;
    private bool _editing;
    private string _value = string.Empty;
    private string? _error;

    protected override void OnInitialized() =>
        _store = Services.GetService(typeof(ISecretStore)) as ISecretStore;

    protected override async Task OnParametersSetAsync()
    {
        if (_store == null || _loadedRef == SecretRef)
            return;
        _loadedRef = SecretRef;
        _editing = false;
        _value = string.Empty;
        try
        {
            _saved = !string.IsNullOrEmpty(SecretRef) && (await _store.ListAsync()).Contains(SecretRef);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"The secret store cannot be read: {ex.Message}";
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            await _store!.SetAsync(SecretRef, _value.Trim());
            _saved = true;
            _editing = false;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"The token could not be saved: {ex.Message}";
        }
        finally
        {
            _value = string.Empty;
        }
    }

    private async Task RemoveAsync()
    {
        try
        {
            await _store!.DeleteAsync(SecretRef);
            _saved = false;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"The token could not be removed: {ex.Message}";
        }
    }

    private void Cancel()
    {
        _editing = false;
        _value = string.Empty;
    }
}
