@namespace DevToolbar.Plugins.Providers
@using DevToolbar.Core.Configuration
@using DevToolbar.Core.Interfaces
@using DevToolbar.Plugins.Shared
@inherits PluginSettingsComponentBase

@* US7.1: per repository, follow GitHub Actions workflow runs. *@
<div class="provider-settings" data-testid="github-actions-settings">
    <p class="plugin-settings-hint">
        Follow the GitHub Actions runs of the repositories of <strong>@Project.Name</strong>. Results are polled in the background.
        Agent sessions will be added when GitHub offers an API for them.
    </p>

    @if (Project.GitRepositories.Count == 0)
    {
        <div class="git-repo-empty">Link a repository folder first (Git Tools settings).</div>
    }

    @foreach (var repository in Project.GitRepositories)
    {
        var current = repository;
        var tracking = current.GitHub;
        <section class="provider-repo" @key="current.Path">
            <h5>📁 @current.Name</h5>
            <label class="provider-check">
                <input type="checkbox" data-testid="github-track-actions" checked="@(tracking?.TrackActions == true)"
                       @onchange="e => ToggleAsync(current, e.Value is true)" />
                <span>Follow GitHub Actions workflow runs</span>
            </label>
            @if (tracking != null)
            {
                <form class="provider-fields" @onsubmit="() => SaveRepositoryAsync(current)" @onsubmit:preventDefault="true">
                    <label class="provider-field">
                        <span>Repository (owner/name)</span>
                        <input data-testid="github-actions-repository" placeholder="contoso/alpha-api"
                               value="@Draft(current)" @oninput="e => _drafts[current.Path] = e.Value?.ToString() ?? string.Empty" />
                    </label>
                    <button type="submit" class="plugin-settings-primary" data-testid="github-actions-save">Save</button>
                    @if (_errors.TryGetValue(current.Path, out var error))
                    {
                        <div class="plugin-settings-error" role="alert">@error</div>
                    }
                </form>
                <SecretField SecretRef="@tracking.SecretRef" Label="GitHub token (Actions: read)" SignInWith="OAuthProvider.GitHub" />
            }
        </section>
    }
</div>

@code {
    private readonly Dictionary<string, string> _drafts = new();
    private readonly Dictionary<string, string> _errors = new();

    private string Draft(GitRepository repository) =>
        _drafts.TryGetValue(repository.Path, out var draft) ? draft : repository.GitHub?.Repository ?? string.Empty;

    private Task ToggleAsync(GitRepository repository, bool enabled)
    {
        var tracking = enabled
            ? (repository.GitHub ?? new GitHubTracking
            {
                Repository = repository.WorkItems?.Provider == WorkItemProviderKind.GitHub && repository.WorkItems.Repository.Length > 0
                    ? repository.WorkItems.Repository
                    : WorkItemsSettingsPanel.GuessGitHubRepository(repository),
                SecretRef = ProviderSettingsValidator.DefaultSecretRef(Project, repository, "github"),
            }) with { TrackActions = true }
            : null;
        _drafts.Remove(repository.Path);
        return ReplaceAsync(repository, repository with { GitHub = tracking });
    }

    private async Task SaveRepositoryAsync(GitRepository repository)
    {
        var candidate = repository.GitHub! with { Repository = Draft(repository).Trim() };
        var error = ProviderSettingsValidator.Validate(candidate);
        if (error != null)
        {
            _errors[repository.Path] = error;
            return;
        }
        _errors.Remove(repository.Path);
        _drafts.Remove(repository.Path);
        await ReplaceAsync(repository, repository with { GitHub = candidate });
    }

    private async Task ReplaceAsync(GitRepository old, GitRepository updated)
    {
        Project.GitRepositories = Project.GitRepositories.Select(r => ReferenceEquals(r, old) ? updated : r).ToList();
        await OnProjectChanged.InvokeAsync(Project);
    }
}
