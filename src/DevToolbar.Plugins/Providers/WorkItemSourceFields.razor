@namespace DevToolbar.Plugins.Providers
@using DevToolbar.Core.Configuration

@* Organization / project (Azure DevOps) or owner/name (GitHub) of a work item source. *@
<form class="provider-fields" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
    @if (Source.Provider == WorkItemProviderKind.AzureDevOps)
    {
        <label class="provider-field">
            <span>Organization</span>
            <input data-testid="ado-organization" placeholder="contoso" @bind="_organization" @bind:event="oninput" />
        </label>
        <label class="provider-field">
            <span>Project</span>
            <input data-testid="ado-project" placeholder="Alpha" @bind="_project" @bind:event="oninput" />
        </label>
    }
    else
    {
        <label class="provider-field">
            <span>Repository (owner/name)</span>
            <input data-testid="github-repository" placeholder="contoso/alpha-api" @bind="_repository" @bind:event="oninput" />
        </label>
    }
    <button type="submit" class="plugin-settings-primary" data-testid="provider-save">Save</button>
    @if (_message != null)
    {
        <div class="@(_isError ? "plugin-settings-error" : "plugin-settings-hint")" role="status" data-testid="provider-message">@_message</div>
    }
</form>

@code {
    [Parameter, EditorRequired] public WorkItemSource Source { get; set; } = default!;

    [Parameter] public EventCallback<WorkItemSource> OnSave { get; set; }

    private WorkItemSource? _loaded;
    private string _organization = string.Empty;
    private string _project = string.Empty;
    private string _repository = string.Empty;
    private string? _message;
    private bool _isError;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loaded, Source))
            return;
        _loaded = Source;
        _organization = Source.Organization;
        _project = Source.Project;
        _repository = Source.Repository;
    }

    private async Task SaveAsync()
    {
        var candidate = Source with
        {
            Organization = _organization.Trim(),
            Project = _project.Trim(),
            Repository = _repository.Trim(),
        };
        var error = ProviderSettingsValidator.Validate(candidate);
        _isError = error != null;
        _message = error ?? "Saved.";
        if (error == null)
            await OnSave.InvokeAsync(candidate);
    }
}
