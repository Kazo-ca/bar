@page "/settings"
@using DevToolbar.Core.Interfaces
@using DevToolbar.Core.Models
@using DevToolbar.UI.Services
@using DevToolbar.UI.Components
@inject ISettingsService SettingsService
@inject IPluginLoader PluginLoader
@inject IGlobalSettingsService GlobalSettingsService
@inject IWindowService WindowService
@inject INotificationService NotificationService
@inject INativeService NativeService

<PageTitle>DevToolbar - Settings</PageTitle>

@* Declares its content height to the host (window grows up to the screen), scrolls the rest. *@
<HostSizedRegion Id="settings-page" Class="settings-page">
    <header class="settings-header">
        <h2>⚙️ Settings</h2>
        <a href="/" class="settings-back">← Back to Toolbar</a>
    </header>

    <div class="settings-content">
        @if (_activeProject != null)
        {
            <section class="settings-section">
                <h3>Active Project</h3>
                <div class="settings-field">
                    <label>Name</label>
                    <span class="settings-value">@_activeProject.Name</span>
                </div>
                <div class="settings-field">
                    <label>Type</label>
                    <span class="settings-value">@_activeProject.ProjectType</span>
                </div>
                <div class="settings-field">
                    <label>Path</label>
                    <span class="settings-value settings-path">@_activeProject.Path</span>
                </div>
                <div class="settings-field">
                    <label>Default Branch</label>
                    <span class="settings-value">@_activeProject.DefaultBranch</span>
                </div>
                @if (!string.IsNullOrEmpty(_activeProject.RepositoryUrl))
                {
                    <div class="settings-field">
                        <label>Repository</label>
                        <a href="@_activeProject.RepositoryUrl" target="_blank" class="settings-value settings-link">@_activeProject.RepositoryUrl</a>
                    </div>
                }
            </section>

            <section class="settings-section">
                <h3>Theme</h3>
                <div class="settings-field">
                    <label for="theme-select">Theme</label>
                    <select id="theme-select" class="settings-theme-select" data-testid="theme-select"
                            value="@ThemeNames.Normalize(_activeProject.Theme.Name)"
                            @onchange="@(e => UpdateThemeName(e.Value?.ToString()))">
                        @foreach (var name in ThemeNames.All)
                        {
                            <option value="@name">@ThemeNames.DisplayName(name)</option>
                        }
                    </select>
                </div>
                <div class="settings-field">
                    <label>Accent Color</label>
                    <div class="settings-color-preview">
                        <input type="color" value="@_activeProject.Theme.AccentColor"
                               class="settings-color-picker"
                               @onchange="@(e => UpdateAccentColor(e.Value?.ToString() ?? "#0d6efd"))" />
                        <span class="settings-value">@_activeProject.Theme.AccentColor</span>
                    </div>
                </div>
                <div class="settings-field">
                    <label>Font Family</label>
                    <select class="settings-font-select" value="@_activeProject.Theme.FontFamily"
                            @onchange="@(e => UpdateFontFamily(e.Value?.ToString() ?? "Segoe UI"))">
                        <option value="Segoe UI">Segoe UI</option>
                        <option value="Cascadia Code">Cascadia Code</option>
                        <option value="Consolas">Consolas</option>
                        <option value="JetBrains Mono">JetBrains Mono</option>
                        <option value="Fira Code">Fira Code</option>
                        <option value="Inter">Inter</option>
                    </select>
                </div>
            </section>

            @* ── Toolbar Behavior Settings ── *@
            <section class="settings-section settings-toolbar-section">
                <h3>🖥️ Toolbar Behavior</h3>

                <div class="settings-field">
                    <label>Mode</label>
                    <div class="settings-radio-group">
                        @foreach (var behavior in Enum.GetValues<ToolbarBehavior>())
                        {
                            <label class="settings-radio-item">
                                <input type="radio" name="toolbarBehavior"
                                       value="@behavior"
                                       checked="@(_globalSettings.ToolbarBehavior == behavior)"
                                       @onchange="@(() => UpdateToolbarBehavior(behavior))" />
                                <span class="radio-label">@GetBehaviorLabel(behavior)</span>
                                <span class="radio-desc">@GetBehaviorDescription(behavior)</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="settings-field">
                    <label>Target Monitor</label>
                    <select class="settings-monitor-select"
                            value="@_globalSettings.TargetMonitorIndex"
                            @onchange="@(e => UpdateTargetMonitor(int.TryParse(e.Value?.ToString(), out var v) ? v : 0))">
                        @foreach (var monitor in _monitors)
                        {
                            <option value="@monitor.Index">@monitor.DisplayLabel (@(monitor.Bounds.Width)×@(monitor.Bounds.Height))</option>
                        }
                    </select>
                </div>

                <div class="settings-field">
                    <label>Toolbar Height (px)</label>
                    <input type="number" min="32" max="120"
                           value="@_globalSettings.ToolbarHeight"
                           class="settings-monitor-select"
                           @onchange="@(e => UpdateToolbarHeight(int.TryParse(e.Value?.ToString(), out var v) ? v : 56))" />
                </div>

                <div class="settings-plugin-row">
                    <label class="settings-toggle">
                        <input type="checkbox"
                               checked="@_globalSettings.ShowActiveWindows"
                               class="settings-plugin-checkbox"
                               @onchange="@(e => UpdateShowActiveWindows((bool)(e.Value ?? false)))" />
                        <span class="settings-toggle-slider"></span>
                    </label>
                    <span class="settings-plugin-name">Show Active Windows</span>
                </div>
            </section>

            @* ── Toolbar modules: order and widths (US3.6, US3.7) ── *@
            <section class="settings-section settings-modules-section" data-testid="settings-modules-section">
                <div class="settings-section-title-row">
                    <h3>Toolbar Modules</h3>
                    <div class="settings-modules-resets">
                        <button type="button" class="settings-modules-reset" data-testid="settings-reset-order"
                                disabled="@(!_layout.HasCustomOrder)" @onclick="ResetModuleOrderAsync">Reset order</button>
                        <button type="button" class="settings-modules-reset" data-testid="settings-reset-widths"
                                disabled="@(!_layout.HasCustomWidths)" @onclick="ResetModuleWidthsAsync">Reset widths</button>
                    </div>
                </div>
                <p class="settings-hint">Right-click a module on the toolbar to move it or reset its width. Drag the right edge of a resizable module to widen it.</p>
                @foreach (var (zoneName, zone) in ModuleZones())
                {
                    <div class="settings-modules-zone">
                        <div class="settings-subtitle">@zoneName</div>
                        @for (var i = 0; i < zone.Count; i++)
                        {
                            var moduleId = zone[i];
                            var width = _layout.SavedWidth(moduleId);
                            <div class="settings-module-row" data-module-id="@moduleId">
                                <span class="settings-module-name">@ToolbarZones.LabelOf(moduleId, _allPlugins)</span>
                                @if (width != null)
                                {
                                    <span class="settings-module-width">@(width) px</span>
                                }
                                <button type="button" class="settings-module-move" title="Move up (left on the toolbar)" aria-label="Move @ToolbarZones.LabelOf(moduleId, _allPlugins) up"
                                        disabled="@(i == 0)" @onclick="() => MoveModuleAsync(zone, moduleId, -1)">▲</button>
                                <button type="button" class="settings-module-move" title="Move down (right on the toolbar)" aria-label="Move @ToolbarZones.LabelOf(moduleId, _allPlugins) down"
                                        disabled="@(i == zone.Count - 1)" @onclick="() => MoveModuleAsync(zone, moduleId, 1)">▼</button>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="settings-section settings-plugins-section">
                <div class="settings-section-title-row">
                    <h3>Enabled Plugins</h3>
                    <button type="button" class="settings-configure-all" @onclick="() => OpenPluginSettings(null)">🧩 Configure plugins…</button>
                </div>
                <div class="settings-plugins-list">
                    @foreach (var plugin in _allPlugins)
                    {
                        var pluginId = plugin.UniqueId;
                        var isEnabled = _activeProject.EnabledPlugins.Contains(pluginId);
                        <div class="settings-plugin-row" data-plugin-id="@pluginId">
                            <label class="settings-toggle">
                                <input type="checkbox" checked="@isEnabled"
                                       class="settings-plugin-checkbox"
                                       @onchange="@(e => TogglePlugin(pluginId, (bool)(e.Value ?? false)))" />
                                <span class="settings-toggle-slider"></span>
                            </label>
                            <span class="settings-plugin-name">@plugin.Name</span>
                            <span class="settings-plugin-id">@plugin.UniqueId</span>
                            <button type="button" class="settings-plugin-configure" title="Configure @plugin.Name"
                                    @onclick="() => OpenPluginSettings(pluginId)">⚙ Configure</button>
                        </div>
                    }
                </div>
            </section>

            <section class="settings-section">
                <h3>Quick Actions (@_activeProject.Actions.Count)</h3>
                <div class="settings-actions-list">
                    @foreach (var action in _activeProject.Actions)
                    {
                        <div class="settings-action-row">
                            <span class="settings-action-icon">@action.Icon</span>
                            <span class="settings-action-label">@action.Label</span>
                            <span class="settings-action-path">@action.ProcessPath</span>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="settings-section">
            <h3>All Projects</h3>
            <div class="settings-projects-list">
                @if (_projects != null)
                {
                    @foreach (var project in _projects)
                    {
                        var isActive = project.Id == _activeProject?.Id;
                        <div class="settings-project-row @(isActive ? "active" : "")"
                             @onclick="@(() => SwitchProject(project.Id))"
                             style="cursor: pointer;">
                            <span class="settings-project-indicator" style="background-color: @project.Theme.AccentColor"></span>
                            <span class="settings-project-name">@project.Name</span>
                            <span class="settings-project-type">@project.ProjectType</span>
                            @if (isActive)
                            {
                                <span class="settings-project-badge">Active</span>
                            }
                        </div>
                    }
                }
            </div>
            @if (_showNewProject)
            {
                <NewProjectForm OnCreated="OnProjectCreated" OnCancel="() => _showNewProject = false" />
            }
            else
            {
                <button class="settings-btn" data-testid="settings-new-project" @onclick="() => _showNewProject = true">＋ New project</button>
            }
        </section>

        <section class="settings-section" data-testid="settings-config-section">
            <h3>Configuration</h3>
            <p class="settings-description">All projects, repositories and settings are stored in one file per user. Access tokens are never written to it.</p>
            <div class="settings-field">
                <label>File</label>
                <span class="settings-value settings-path" data-testid="settings-config-path">@(SettingsService.ConfigurationLocation ?? "In memory (not saved)")</span>
            </div>
        </section>

        <TimeTrackingSettings />

        <SecretStoreSettings />

        <OAuthAppsSettings />

        <section class="settings-section settings-app-section" data-testid="settings-app-section">
            <h3>Application</h3>
            <p class="settings-description">Close the toolbar completely. On Windows you can also use the DevToolbar icon in the notification area.</p>
            @if (_confirmQuit)
            {
                <div class="settings-quit-confirm">
                    <span class="settings-quit-question">Quit DevToolbar?</span>
                    <button class="settings-btn settings-btn-danger" data-testid="settings-quit-confirm" @onclick="QuitApplication">Quit</button>
                    <button class="settings-btn" data-testid="settings-quit-cancel" @onclick="() => _confirmQuit = false">Cancel</button>
                </div>
            }
            else
            {
                <button class="settings-btn settings-btn-danger" data-testid="settings-quit" @onclick="() => _confirmQuit = true">⏻ Quit DevToolbar</button>
            }
            @if (_quitRequested)
            {
                <p class="settings-description" data-testid="settings-quit-status">Closing DevToolbar…</p>
            }
        </section>
    </div>
</HostSizedRegion>

@* Rendered outside .settings-page: its backdrop-filter would otherwise become the
   containing block of the fixed overlay and clip the window to the page column. *@
<PluginSettingsWindow IsVisible="_showPluginSettings" InitialPluginId="@_pluginSettingsId"
                      OnClose="ClosePluginSettings" OnProjectChanged="OnPluginSettingsChanged" />

@code {
    private bool _confirmQuit;
    private bool _quitRequested;

    private ProjectConfig? _activeProject;
    private IReadOnlyList<ProjectConfig>? _projects;
    private IReadOnlyList<IPlugin> _allPlugins = Array.Empty<IPlugin>();
    private GlobalSettings _globalSettings = new();
    private List<MonitorInfo> _monitors = new();

    [Inject]
    private ThemeService ThemeService { get; set; } = default!;

    private ToolbarLayoutController _layout = default!;

    protected override async Task OnInitializedAsync()
    {
        _activeProject = SettingsService.GetActiveProject();
        _projects = await SettingsService.GetProjectsAsync();
        _allPlugins = PluginLoader.GetPlugins();

        // Load global settings and monitor list
        _globalSettings = GlobalSettingsService.Current;
        _layout = new ToolbarLayoutController(GlobalSettingsService);
        _monitors = WindowService.GetMonitors();
    }

    private bool _showPluginSettings;
    private string? _pluginSettingsId;

    private async Task TogglePlugin(string pluginId, bool enabled)
    {
        if (_activeProject == null) return;

        var others = _activeProject.EnabledPlugins.Where(id => id != pluginId);
        _activeProject.EnabledPlugins = enabled ? [.. others, pluginId] : others.ToList();
        try
        {
            await SettingsService.SaveProjectAsync(_activeProject);
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Could not save plugin settings: {ex.Message}", "Settings");
        }
    }

    private IEnumerable<(string Name, IReadOnlyList<string> Zone)> ModuleZones()
    {
        if (_activeProject == null) yield break;
        var visible = _allPlugins.Where(p => _activeProject.EnabledPlugins.Contains(p.UniqueId)).ToList();
        yield return ("Main zone", _layout.Arrange(ToolbarZones.MainDefaults(visible)));
        yield return ("System zone", _layout.Arrange(ToolbarZones.SystemDefaults(visible)));
    }

    private Task MoveModuleAsync(IReadOnlyList<string> zone, string moduleId, int offset) =>
        SaveLayoutAsync(() => _layout.MoveAsync(zone, moduleId, offset));

    private Task ResetModuleOrderAsync() => SaveLayoutAsync(_layout.ResetOrderAsync);

    private Task ResetModuleWidthsAsync() => SaveLayoutAsync(_layout.ResetWidthsAsync);

    private async Task SaveLayoutAsync(Func<Task> change)
    {
        try
        {
            await change();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Could not save the toolbar layout: {ex.Message}", "Settings");
        }
    }

    private void OpenPluginSettings(string? pluginId)
    {
        _pluginSettingsId = pluginId;
        _showPluginSettings = true;
    }

    private void ClosePluginSettings() => _showPluginSettings = false;

    private void OnPluginSettingsChanged(ProjectConfig project) => _activeProject = project;

    private Task UpdateThemeName(string? name) =>
        ApplyThemeAsync(theme => theme.Name = ThemeNames.Normalize(name));

    private Task UpdateAccentColor(string color) =>
        ApplyThemeAsync(theme => theme.AccentColor = color);

    private Task UpdateFontFamily(string fontFamily) =>
        ApplyThemeAsync(theme => theme.FontFamily = fontFamily);

    /// <summary>Applies a theme change to the toolbar at once, then saves it with the project.</summary>
    private async Task ApplyThemeAsync(Action<ThemeConfig> change)
    {
        if (_activeProject == null) return;
        change(_activeProject.Theme);
        ThemeService.SetTheme(_activeProject.Theme);
        try
        {
            await SettingsService.SaveProjectAsync(_activeProject);
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Could not save the theme: {ex.Message}", "Settings");
        }
    }

    private bool _showNewProject;

    private async Task OnProjectCreated(ProjectConfig project)
    {
        _showNewProject = false;
        _projects = await SettingsService.GetProjectsAsync();
        _activeProject = SettingsService.GetActiveProject();
    }

    private async Task SwitchProject(string projectId)
    {
        if (_activeProject?.Id == projectId) return;

        await SettingsService.SetActiveProjectAsync(projectId);
        _activeProject = SettingsService.GetActiveProject();
    }

    private void QuitApplication()
    {
        _confirmQuit = false;
        _quitRequested = true;
        NativeService.ExitApplication();
    }

    // --- Toolbar Behavior settings ---

    private async Task UpdateToolbarBehavior(ToolbarBehavior behavior)
    {
        await GlobalSettingsService.UpdateAsync(s => s.ToolbarBehavior = behavior);
        _globalSettings = GlobalSettingsService.Current;
        _layout = new ToolbarLayoutController(GlobalSettingsService);
    }

    private async Task UpdateTargetMonitor(int monitorIndex)
    {
        await GlobalSettingsService.UpdateAsync(s => s.TargetMonitorIndex = monitorIndex);
        _globalSettings = GlobalSettingsService.Current;
        _layout = new ToolbarLayoutController(GlobalSettingsService);
    }

    private async Task UpdateToolbarHeight(int height)
    {
        height = Math.Clamp(height, 32, 120);
        await GlobalSettingsService.UpdateAsync(s => s.ToolbarHeight = height);
        _globalSettings = GlobalSettingsService.Current;
        _layout = new ToolbarLayoutController(GlobalSettingsService);
    }

    private async Task UpdateShowActiveWindows(bool enabled)
    {
        await GlobalSettingsService.UpdateAsync(s => s.ShowActiveWindows = enabled);
        _globalSettings = GlobalSettingsService.Current;
        _layout = new ToolbarLayoutController(GlobalSettingsService);
    }

    private static string GetBehaviorLabel(ToolbarBehavior behavior) => behavior switch
    {
        ToolbarBehavior.DockedTop => "Docked Top",
        ToolbarBehavior.DockedBottom => "Docked Bottom",
        ToolbarBehavior.Floating => "Floating",
        ToolbarBehavior.Overlay => "Overlay",
        _ => behavior.ToString()
    };

    private static string GetBehaviorDescription(ToolbarBehavior behavior) => behavior switch
    {
        ToolbarBehavior.DockedTop => "Anchored at top, reserves screen space",
        ToolbarBehavior.DockedBottom => "Anchored at bottom, reserves screen space",
        ToolbarBehavior.Floating => "Free-floating window, movable",
        ToolbarBehavior.Overlay => "Always on top, no space reserved",
        _ => string.Empty
    };
}
