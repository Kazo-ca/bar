@using DevToolbar.Core.Interfaces
@using DevToolbar.Core.Models
@using DevToolbar.UI.Services
@using Microsoft.JSInterop
@inject ISettingsService SettingsService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="project-selector @(_dropdownOpen ? "open" : "")" @ref="_root">
    <button class="project-selector-trigger" @onclick="ToggleDropdown" @onclick:stopPropagation="true" title="Switch project"
            aria-haspopup="true" aria-expanded="@(_dropdownOpen ? "true" : "false")">
        <span class="project-icon">
            <svg class="github-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
        </span>
        <span class="project-name">@(_activeProject?.Name ?? "No Project")</span>
    </button>

    @if (_dropdownOpen && _projects != null)
    {
        <div class="project-dropdown" role="menu">
            @foreach (var project in _projects.Where(p => p.Id != _activeProject?.Id))
            {
                <button class="project-dropdown-item" role="menuitem" @onclick="() => SelectProject(project)" @onclick:stopPropagation="true">
                    <svg class="github-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                    </svg>
                    <span>@project.Name</span>
                </button>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<ProjectConfig>? _projects;
    private ProjectConfig? _activeProject;
    private bool _dropdownOpen;
    private bool _attachPending;
    private ElementReference _root;
    private DismissListener? _dismiss;

    protected override async Task OnInitializedAsync()
    {
        // Closes the menu on outside click or Escape.
        _dismiss = new DismissListener(JS, () => InvokeAsync(CloseDropdownAsync));
        _projects = await SettingsService.GetProjectsAsync();
        _activeProject = SettingsService.GetActiveProject();
        SettingsService.OnActiveProjectChanged += OnProjectChanged;
    }

    private void OnProjectChanged(ProjectConfig project)
    {
        _activeProject = project;
        _ = InvokeAsync(CloseDropdownAsync);
    }

    private async Task ToggleDropdown()
    {
        if (_dropdownOpen)
        {
            await CloseDropdownAsync();
            return;
        }
        _dropdownOpen = true;
        _attachPending = true;
    }

    private async Task CloseDropdownAsync()
    {
        if (_dropdownOpen)
        {
            _dropdownOpen = false;
            if (_dismiss != null) await _dismiss.DetachAsync();
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_attachPending && _dropdownOpen && _dismiss != null)
        {
            _attachPending = false;
            await _dismiss.AttachAsync(_root);
        }
    }

    private async Task SelectProject(ProjectConfig project)
    {
        await SettingsService.SetActiveProjectAsync(project.Id);
        _activeProject = project;
        await CloseDropdownAsync();
    }

    public async ValueTask DisposeAsync()
    {
        SettingsService.OnActiveProjectChanged -= OnProjectChanged;
        if (_dismiss != null) await _dismiss.DisposeAsync();
    }
}
