@using DevToolbar.Core.Configuration
@using DevToolbar.Core.Interfaces
@using DevToolbar.Core.Models
@inject ISettingsService SettingsService
@inject IPluginLoader PluginLoader
@inject INotificationService NotificationService
@inject IServiceProvider Services

@* US5.1: a project is created then linked to one repository and its local folder. *@
<form class="new-project-form" data-testid="new-project-form" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
    <h4>New project</h4>
    <div class="new-project-grid">
        <label>
            <span>Local folder of the repository *</span>
            <span class="new-project-folder">
                <input class="settings-text-input" data-testid="new-project-path" placeholder="C:\src\my-repo"
                       @bind="_path" @bind:event="oninput" />
                @if (_folderPicker != null)
                {
                    <button type="button" class="settings-btn" data-testid="new-project-browse" @onclick="BrowseAsync">Browse…</button>
                }
            </span>
        </label>
        <label>
            <span>Name</span>
            <input class="settings-text-input" data-testid="new-project-name" placeholder="Folder name by default"
                   @bind="_name" @bind:event="oninput" />
        </label>
    </div>
    @if (_error != null)
    {
        <div class="settings-form-error" role="alert" data-testid="new-project-error">@_error</div>
    }
    <div class="new-project-actions">
        <button type="submit" class="settings-btn" data-testid="new-project-create" disabled="@string.IsNullOrWhiteSpace(_path)">＋ Create project</button>
        <button type="button" class="settings-btn" @onclick="OnCancel">Cancel</button>
    </div>
</form>

@code {
    /// <summary>Raised with the new project after it has been saved and activated.</summary>
    [Parameter] public EventCallback<ProjectConfig> OnCreated { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private string _path = string.Empty;
    private string _name = string.Empty;
    private string? _error;
    private IFolderPickerService? _folderPicker;

    protected override void OnInitialized() =>
        _folderPicker = Services.GetService(typeof(IFolderPickerService)) as IFolderPickerService;

    private async Task BrowseAsync()
    {
        var folder = await _folderPicker!.PickFolderAsync(string.IsNullOrWhiteSpace(_path) ? null : _path);
        if (!string.IsNullOrEmpty(folder))
            _path = folder;
    }

    private async Task CreateAsync()
    {
        _error = ProjectFactory.Validate(_name, _path);
        if (_error != null)
            return;

        try
        {
            var existing = (await SettingsService.GetProjectsAsync()).Select(p => p.Id);
            var plugins = PluginLoader.GetPlugins().Select(p => p.UniqueId);
            var project = ProjectFactory.Create(_name, _path, existing, plugins);
            await SettingsService.AddProjectAsync(project);
            _path = _name = string.Empty;
            NotificationService.ShowSuccess($"Project {project.Name} created.", "Settings");
            await OnCreated.InvokeAsync(project);
        }
        catch (Exception ex) when (ex is ArgumentException or NotSupportedException or IOException)
        {
            _error = ex.Message;
        }
    }
}
