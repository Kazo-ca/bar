@using DevToolbar.Core.Interfaces
@implements IDisposable

@* US4.3: script output, shown line by line while the script runs. *@
<div class="terminal-overlay @(_isVisible ? "visible" : "")" @onclick="Close">
    <div class="terminal-modal" @onclick:stopPropagation="true">
        <header class="terminal-header">
            <h3>🖥 Terminal Output</h3>
            <span class="terminal-title">@_title</span>
            <button class="terminal-close" title="@(_isRunning ? "Close and stop the script" : "Close")" @onclick="Close">✕</button>
        </header>
        <div class="terminal-body">
            <pre class="terminal-output">@_command@foreach (var line in Snapshot())
{<span class="@(line.IsError ? "terminal-line terminal-stderr" : "terminal-line")">@line.Text
</span>}</pre>
        </div>
        <footer class="terminal-footer">
            @if (_isRunning)
            {
                <span class="terminal-running">⏳ Running...</span>
                <button class="terminal-stop" title="Stop the script" @onclick="Stop">■ Stop</button>
            }
            else if (_cancelled)
            {
                <span class="terminal-exit failure">Stopped</span>
            }
            else if (_exitCode.HasValue)
            {
                <span class="terminal-exit @(_exitCode == 0 ? "success" : "failure")">
                    Exit: @_exitCode
                </span>
            }
        </footer>
    </div>
</div>

@code {
    /// <summary>Most lines kept on screen; older ones are dropped.</summary>
    public const int MaxLines = 5000;

    /// <summary>Shortest time between two refreshes while lines arrive.</summary>
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromMilliseconds(50);

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private readonly object _gate = new();
    private readonly List<ScriptOutputLine> _lines = new();
    private bool _isVisible;
    private string _title = string.Empty;
    private string _command = string.Empty;
    private bool _isRunning;
    private bool _cancelled;
    private int? _exitCode;
    private CancellationTokenSource? _run;
    private int _refreshPending;

    protected override void OnParametersSet()
    {
        _isVisible = IsVisible;
    }

    public async Task RunScript(IScriptService scriptService, string interpreter, string scriptPath, string arguments = "")
    {
        _run?.Cancel();
        using var run = new CancellationTokenSource();
        _run = run;
        lock (_gate) _lines.Clear();
        _isVisible = true;
        _isRunning = true;
        _cancelled = false;
        _exitCode = null;
        _title = $"{interpreter} {scriptPath}";
        _command = $"$ {interpreter} {scriptPath} {arguments}".TrimEnd() + "\n\n";
        StateHasChanged();

        ScriptResult result;
        try
        {
            result = await scriptService.ExecuteAsync(interpreter, scriptPath, arguments, Append, run.Token);
        }
        catch (Exception ex)
        {
            Append(new ScriptOutputLine($"Failed to execute: {ex.Message}", IsError: true));
            result = new ScriptResult { ExitCode = -1 };
        }

        if (!ReferenceEquals(_run, run))
            return; // A newer run replaced this one.
        _run = null;
        _exitCode = result.ExitCode;
        _cancelled = result.WasCancelled;
        _isRunning = false;
        StateHasChanged();
    }

    private void Append(ScriptOutputLine line)
    {
        lock (_gate)
        {
            _lines.Add(line);
            if (_lines.Count > MaxLines)
                _lines.RemoveRange(0, _lines.Count - MaxLines);
        }
        // Coalesce refreshes: lines can arrive much faster than the UI should render.
        if (Interlocked.Exchange(ref _refreshPending, 1) == 1)
            return;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(RefreshInterval);
            Interlocked.Exchange(ref _refreshPending, 0);
            StateHasChanged();
        });
    }

    private List<ScriptOutputLine> Snapshot()
    {
        lock (_gate) return _lines.ToList();
    }

    private void Stop() => _run?.Cancel();

    private async Task Close()
    {
        // A hidden script could not be stopped any more: closing stops it.
        Stop();
        _isVisible = false;
        await OnClose.InvokeAsync();
    }

    public void Dispose() => _run?.Cancel();
}
