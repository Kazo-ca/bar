@using Kazo.Bar.Core.Interfaces
@using Kazo.Bar.Core.Models
@using Kazo.Bar.Core.Dialogs
@implements IDisposable
@inject IServiceProvider Services

@*
    Declares a known surface size to the host while rendered, without measuring
    (e.g. a fixed-size dialog). Renders nothing. No-op on hosts without IHostSurfaceService
    and inside a dialog (the toolbar window must not grow for it).
*@

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public double Width { get; set; }
    [Parameter, EditorRequired] public double Height { get; set; }

    [CascadingParameter] public DialogContext? Dialog { get; set; }

    private IHostSurfaceService? _surface;
    private string? _requestedId;

    protected override void OnInitialized() =>
        _surface = Dialog != null ? null : Services.GetService(typeof(IHostSurfaceService)) as IHostSurfaceService;

    protected override void OnParametersSet()
    {
        if (_surface == null) return;
        if (_requestedId != null && _requestedId != Id) _surface.ReleaseSize(_requestedId);
        _surface.RequestSize(Id, new SurfaceSize(Width, Height));
        _requestedId = Id;
    }

    public void Dispose()
    {
        if (_requestedId != null) _surface?.ReleaseSize(_requestedId);
    }
}
