@using Kazo.Bar.Core.Interfaces
@using Kazo.Bar.Core.Models
@inject IServiceProvider Services
@inject INotificationService NotificationService

@* US2.4: the user chooses where access tokens are stored. Values are never shown here. *@
@if (_selector != null)
{
    <section class="settings-section" data-testid="settings-secrets-section">
        <h3>Access tokens</h3>
        <p class="settings-description">
            Tokens for GitHub and Azure DevOps are never written to the configuration file, which only keeps a reference.
            Choose where they are stored; existing tokens are moved when you change.
        </p>
        <div class="settings-secret-options" role="radiogroup" aria-label="Secret store">
            @foreach (var kind in _selector.Available)
            {
                var current = kind == _selector.Current;
                <label class="settings-secret-option @(current ? "active" : "")">
                    <input type="radio" name="secret-store" data-testid="@($"secret-store-{kind}")"
                           checked="@current" disabled="@_busy" @onchange="() => SwitchAsync(kind)" />
                    <span class="settings-secret-title">@Title(kind)</span>
                    <span class="settings-secret-desc">@Description(kind)</span>
                </label>
            }
        </div>
    </section>
}

@code {
    private ISecretStoreSelector? _selector;
    private bool _busy;

    protected override void OnInitialized() =>
        _selector = Services.GetService(typeof(ISecretStoreSelector)) as ISecretStoreSelector;

    private async Task SwitchAsync(SecretStoreKind kind)
    {
        if (_selector == null || _busy || kind == _selector.Current)
            return;
        _busy = true;
        try
        {
            var moved = await _selector.SwitchToAsync(kind);
            NotificationService.ShowSuccess($"Tokens are now stored in {Title(kind)} ({moved} moved).", "Settings");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Could not change the token store: {ex.Message}", "Settings");
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Title(SecretStoreKind kind) => kind switch
    {
        SecretStoreKind.CredentialManager => "Windows Credential Manager",
        SecretStoreKind.EncryptedFile => "Encrypted file",
        _ => kind.ToString(),
    };

    private static string Description(SecretStoreKind kind) => kind switch
    {
        SecretStoreKind.CredentialManager => "Stored by Windows, listed under Windows Credentials as \"Kazo.Bar:…\".",
        SecretStoreKind.EncryptedFile => @"%APPDATA%\Kazo\Bar\secrets.json, encrypted for your Windows account (DPAPI).",
        _ => string.Empty,
    };
}
