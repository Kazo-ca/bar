@using Kazo.Bar.Core.Interfaces
@using Kazo.Bar.Core.Models
@using Kazo.Bar.UI.Services
@using Kazo.Bar.UI.Components
@using Kazo.Bar.Core.Layout
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IPluginLoader PluginLoader
@inject ISettingsService SettingsService
@inject IProcessService ProcessService
@inject INotificationService NotificationService
@inject IScriptService ScriptService
@inject ITimeTrackingService TimeTrackingService
@inject ThemeService ThemeService
@inject IGlobalSettingsService GlobalSettingsService
@inject IServiceProvider Services

@* US3.2: project-provided custom CSS is injected after the base theme variables *@
@if (ThemeService.GetCustomCss() is { Length: > 0 } customCss)
{
    <style id="devtoolbar-custom-css">@((MarkupString)customCss)</style>
}

<CascadingValue Value="_dismiss" IsFixed="true">
<CascadingValue Value="_layout" IsFixed="true">
<div @ref="_shell" class="toolbar-shell @(_layout.IsReorganizing ? "reorganizing" : "")" style="@ThemeService.GetCssVariables()" data-theme="@ThemeService.ThemeName"
     data-interactive="@(_isInteractive ? "true" : "false")"
     @onclick="ReportActivity" @onkeydown="ReportActivity">
    @* ── Project pill (z-index: 20), always first. With the Git plugin it shows the repository,
          branch and worktree, and the Git module (Pull / Push / Pull & Push) is glued to it:
          both form one block that stays on the left (US5.6, US3.9). ── *@
    @{
        var gitPlugin = VisiblePlugins.FirstOrDefault(p => p.UniqueId == ToolbarZones.GitPluginId && p.IsEnabled);
        var pillContent = VisiblePlugins.Where(p => p.IsEnabled).OfType<IProjectPillContent>().FirstOrDefault();
    }
    <ModuleFrame ModuleId="@ToolbarZones.ProjectModuleId" Label="Project" CssClass="module-project"
                 Layout="@(pillContent != null ? ProjectPillLayout : PluginLayout.Fixed)">
        <ProjectSelector PillContent="pillContent" />
    </ModuleFrame>
    @if (gitPlugin?.Render() is { } gitFragment)
    {
        @* Git module (z-index: 10), overlaps under the project pill *@
        <ModuleFrame ModuleId="@gitPlugin.UniqueId" Label="@gitPlugin.Name" CssClass="module-git" Layout="@gitPlugin.Layout">
            <div class="plugin-panel git-panel" data-plugin-id="@gitPlugin.UniqueId" aria-label="@gitPlugin.Name">
                <div class="plugin-content">@gitFragment</div>
            </div>
        </ModuleFrame>
    }

    @* ── Main zone: quick actions by default, in the user's order (US3.7, US3.9) ── *@
    @{
        var arrangement = _layout.Arrange(ToolbarZones.MainDefaults(VisiblePlugins), ToolbarZones.SystemDefaults(VisiblePlugins));
        var timer = GetTimerView();
        var reorganizing = _layout.IsReorganizing;
    }
    @foreach (var moduleId in arrangement.Main)
    {
        @RenderModule(moduleId, arrangement.Main, false, null, timer)
    }
    @if (reorganizing)
    {
        @* US3.9: drop here to put a module at the end of the main zone (also works when it is empty) *@
        var mainTarget = ToolbarLayoutController.ZoneTargetId(ToolbarModuleLayout.MainZone);
        <div class="module-drop-slot @(_layout.DropTargetId == mainTarget ? "drop-target" : "")" data-testid="module-drop-main"
             title="Drop here to put the module at the end of the main zone"
             @ondragenter="() => _layout.DragOver(mainTarget)" @ondragover="() => _layout.DragOver(mainTarget)" @ondragover:preventDefault="true"
             @ondrop="() => _layout.DropAtEnd(ToolbarModuleLayout.MainZone)" @ondrop:preventDefault="true"></div>
    }

    @* ── Zone 3b: Taskbar — Open Windows (conditional) ── *@
    <TaskbarModule />

    @* ── Zone 4: System — Plugin indicators + Timer by default (user's order) + Settings (z-index: 20) ── *@
    <div class="module-system">
        @{
            var systemZone = arrangement.System;
            var systemVisible = SystemVisibleCount(systemZone);
            var overflowEntries = new List<OverflowEntry>();
        }
        @for (var index = 0; index < systemZone.Count; index++)
        {
            @RenderModule(systemZone[index], systemZone, index >= systemVisible, overflowEntries, timer)
        }
        @* US3.8: modules that do not fit, in a "»" menu *@
        <ModuleOverflowMenu Entries="overflowEntries" />
        <button class="system-btn" @onclick="ToggleTimeReport" title="Time Report">📊</button>
        @if (reorganizing)
        {
            @* US3.9: accept or cancel the new layout, in place of the settings button *@
            <button class="system-btn system-reorganize-accept" data-testid="reorganize-accept" title="Keep the new layout"
                    aria-label="Keep the new layout" @onclick="_layout.CommitReorganizeAsync"><FaIcon Name="circle-check" /></button>
            <button class="system-btn system-reorganize-cancel" data-testid="reorganize-cancel" title="Cancel the changes (Esc)"
                    aria-label="Cancel the changes" @onclick="_layout.CancelReorganize"><FaIcon Name="circle-xmark" /></button>
        }
        else
        {
            <a href="/settings" class="system-btn system-settings" title="Settings">⚙️</a>
        }
        @if (DebugFeatures.Enabled)
        {
            <TestDropdown />
        }
    </div>

    @* ── Drag handle (desktop hosts that support moving the window) ── *@
    <ToolbarDragHandle Drag="_drag" />
</div>

@* ── Overlays ── *@
<TimeReport IsVisible="@_showTimeReport" OnClose="CloseTimeReport" />
<TerminalOutput @ref="_terminalOutput" IsVisible="@_showTerminal" OnClose="CloseTerminal" />
<ToastContainer />
</CascadingValue>
</CascadingValue>
<PopupDismissListener Service="_dismiss" />

@code {
    // Hosts may register a singleton so native events (window deactivation, move)
    // can close popups; otherwise a page-local instance is used.
    private PopupDismissService _dismiss = default!;
    private ToolbarLayoutController _layout = default!;
    private ElementReference _shell;
    private IJSObjectReference? _overflowModule;
    private DotNetObjectReference<MainLayout>? _self;

    /// <summary>Width of the "»" button (a system button).</summary>
    private const int OverflowButtonWidth = 32;

    /// <summary>System zone as last measured, and how many of its modules fit (US3.8); null = all.</summary>
    private string[] _measuredSystemIds = Array.Empty<string>();
    private int? _systemVisible;
    private IWindowDragService? _drag;
    private List<ActionConfig> _actions = new();
    private IReadOnlyList<IPlugin>? _visiblePlugins;
    private bool _showTimeReport;
    private bool _showTerminal;
    private TerminalOutput? _terminalOutput;
    private string _currentProjectId = "";
    private bool _isInteractive;
    private IReadOnlyList<IPlugin> _subscribedPlugins = Array.Empty<IPlugin>();
    private System.Threading.Timer? _clockTimer;

    private const string TimeTrackerPluginId = ToolbarZones.TimeTrackerPluginId;
    private const string ActionsModuleId = ToolbarZones.ActionsModuleId;
    private const string TimerModuleId = ToolbarZones.TimerModuleId;
    private static readonly TimeSpan ClockInterval = TimeSpan.FromSeconds(1);

    /// <summary>The project pill can be widened when it shows long repository or branch names (US3.6).</summary>
    private static readonly PluginLayout ProjectPillLayout = PluginLayout.ResizableWidth(defaultWidth: 300, minWidth: 170, maxWidth: 560);

    private IReadOnlyList<IPlugin> VisiblePlugins => _visiblePlugins ?? Array.Empty<IPlugin>();

    /// <summary>
    /// Visible plugins shown as compact indicators in the system zone (Work Items, CI/CD...).
    /// Git has its own module and the Time Tracker is opened from the timer display.
    /// </summary>
    private IEnumerable<IPlugin> IndicatorPlugins => ToolbarZones.Indicators(VisiblePlugins);

    protected override async Task OnInitializedAsync()
    {
        _dismiss = Services.GetService(typeof(PopupDismissService)) as PopupDismissService ?? new PopupDismissService();
        _drag = Services.GetService(typeof(IWindowDragService)) as IWindowDragService;
        _layout = new ToolbarLayoutController(GlobalSettingsService);
        _layout.Changed += OnPluginStateChanged;
        _dismiss.DismissRequested += OnDismissRequested;
        SettingsService.OnActiveProjectChanged += OnProjectChanged;
        TimeTrackingService.OnTrackingChanged += OnPluginStateChanged;

        // Plugins render through RenderFragments whose handlers belong to the plugin, not to
        // this component, so we re-render whenever a plugin reports a state change.
        _subscribedPlugins = PluginLoader.GetPlugins();
        foreach (var plugin in _subscribedPlugins)
        {
            plugin.OnStateChanged += OnPluginStateChanged;
        }

        // Keeps the running timer display live (US5.3).
        _clockTimer = new System.Threading.Timer(_ => OnClockTick(), null, ClockInterval, ClockInterval);

        var project = SettingsService.GetActiveProject();
        if (project != null)
        {
            await ApplyProjectAsync(project);
        }
    }

    /// <summary>How many system modules stay on the toolbar; all of them while reorganizing (US3.9).</summary>
    private int SystemVisibleCount(IReadOnlyList<string> zone) =>
        _layout.IsReorganizing ? zone.Count :
        _systemVisible is { } visible && zone.SequenceEqual(_measuredSystemIds) ? Math.Min(visible, zone.Count) : zone.Count;

    /// <summary>Called by module-overflow.js with the room left for the system zone's modules.</summary>
    [JSInvokable]
    public Task OnSystemZoneMeasured(int room, string[] ids, int[] widths, int gap)
    {
        var visible = ModuleOverflow.VisibleCount(room, widths, gap, OverflowButtonWidth);
        if (visible == _systemVisible && ids.SequenceEqual(_measuredSystemIds)) return Task.CompletedTask;
        _measuredSystemIds = ids;
        _systemVisible = visible;
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _self = DotNetObjectReference.Create(this);
            _overflowModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Kazo.Bar.UI/js/module-overflow.js");
            await _overflowModule.InvokeVoidAsync("observe", _shell, _self);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            // Prerendering or a host without JS: every module stays in the toolbar.
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ThemeService.OnThemeChanged += OnThemeChanged;
            // Prerendered HTML is inert until the interactive render; expose the switch
            // so automation (Playwright) knows when clicks will be handled.
            _isInteractive = true;
            StateHasChanged();
        }
    }

    private void OnPluginStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnClockTick()
    {
        if (TimeTrackingService.GetActive() != null)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void ReportActivity()
    {
        TimeTrackingService.ReportActivity();
    }

    /// <summary>Escape anywhere in the page leaves reorganize mode without saving (US3.9).</summary>
    private void OnDismissRequested(PopupDismissRequest request)
    {
        if (request.Reason != PopupDismissReason.Escape || !_layout.IsReorganizing) return;
        _ = InvokeAsync(_layout.CancelReorganize);
    }

    /// <summary>What the timer module shows (US5.3).</summary>
    private sealed record TimerView(bool IsRunning, bool IsAway, TimeSpan Display, int PendingAbsences, string Title, IPlugin? Tracker);

    private TimerView GetTimerView()
    {
        var activeEntry = TimeTrackingService.GetActive();
        var isRunning = activeEntry != null && activeEntry.ProjectId == _currentProjectId;
        var display = isRunning ? activeEntry!.Duration : TimeTrackingService.GetTodayTotal(_currentProjectId);
        var isAway = TimeTrackingService.IsIdlePaused;
        var pending = TimeTrackingService.PendingAbsences.Count;
        var title = isAway ? "Away: timer paused" : isRunning ? "Timer running" : "Today's total";
        if (pending > 0) title += $" ({pending} absence(s) to label)";
        var tracker = _visiblePlugins?.FirstOrDefault(p => p.UniqueId == TimeTrackerPluginId && p.IsEnabled);
        return new TimerView(isRunning, isAway, display, pending, title, tracker);
    }

    /// <summary>
    /// One module, in whichever zone the user put it (US3.9). <paramref name="overflowEntries"/>
    /// collects the modules that went into the "»" menu (system zone only).
    /// </summary>
    private RenderFragment RenderModule(string moduleId, IReadOnlyList<string> zone, bool overflowed, List<OverflowEntry>? overflowEntries, TimerView timer) => __builder =>
    {
        if (moduleId == ActionsModuleId)
        {
            if (overflowed) overflowEntries?.Add(new OverflowEntry(moduleId, "⚡", "Quick actions", null, 0, null, null));
            <ModuleFrame @key="moduleId" ModuleId="@moduleId" Label="Quick actions" CssClass="module-actions" Zone="zone" Overflowed="overflowed">
                <ActionDeck Actions="@_actions" OnActionClicked="HandleActionClicked" />
            </ModuleFrame>
        }
        else if (moduleId == TimerModuleId)
        {
            if (overflowed) overflowEntries?.Add(new OverflowEntry(moduleId, timer.IsAway ? "💤" : "⏱", "Timer", FormatTime(timer.Display), timer.PendingAbsences, null, timer.Tracker));
            <ModuleFrame @key="moduleId" ModuleId="@moduleId" Label="Timer" CssClass="module-timer" Layout="@(timer.Tracker?.Layout ?? PluginLayout.Fixed)" Zone="zone" Overflowed="overflowed">
                @if (timer.Tracker != null)
                {
                    <PluginPopover Plugin="timer.Tracker" Title="@($"{timer.Title} — click for Time Tracker")"
                                   CssClass="system-timer-popover">
                        <span class="system-timer-display @(timer.IsRunning ? "running" : "") @(timer.IsAway ? "away" : "")">
                            <span class="system-timer-icon">@(timer.IsAway ? "💤" : "⏱")</span>
                            <span class="system-timer-value">@FormatTime(timer.Display)</span>
                            @if (timer.PendingAbsences > 0)
                            {
                                <span class="system-timer-badge" data-testid="absence-badge" title="Absences to label">@timer.PendingAbsences</span>
                            }
                        </span>
                    </PluginPopover>
                }
                else
                {
                    <span class="system-timer-display @(timer.IsRunning ? "running" : "")" title="@timer.Title">
                        <span class="system-timer-icon">⏱</span>
                        <span class="system-timer-value">@FormatTime(timer.Display)</span>
                    </span>
                }
            </ModuleFrame>
        }
        else if (IndicatorPlugins.FirstOrDefault(p => p.UniqueId == moduleId) is { } plugin)
        {
            var indicator = (IPluginIndicator)plugin;
            if (overflowed) overflowEntries?.Add(new OverflowEntry(moduleId, plugin.Icon, plugin.Name, indicator.IndicatorText, indicator.BadgeCount, indicator.StatusLevel, plugin));
            <ModuleFrame @key="moduleId" ModuleId="@moduleId" Label="@plugin.Name" CssClass="module-indicator" Layout="@plugin.Layout" Zone="zone" Overflowed="overflowed">
                <PluginPopover Plugin="plugin" Title="@(indicator.IndicatorTooltip ?? plugin.Name)"
                               TriggerClass="@($"system-indicator {(indicator.StatusLevel is { } level ? "status-" + level : "")}")">
                    <span class="system-indicator-icon">@plugin.Icon</span>
                    @if (!string.IsNullOrEmpty(indicator.IndicatorText))
                    {
                        <span class="system-indicator-text">@indicator.IndicatorText</span>
                    }
                    @if (indicator.BadgeCount > 0)
                    {
                        <span class="system-indicator-badge">@indicator.BadgeCount</span>
                    }
                </PluginPopover>
            </ModuleFrame>
        }
    };

    private void OnThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ApplyProjectAsync(ProjectConfig project)
    {
        _actions = project.Actions;
        _currentProjectId = project.Id;
        ThemeService.SetTheme(project.Theme);

        var allPlugins = PluginLoader.GetPlugins();
        _visiblePlugins = allPlugins
            .Where(p => project.EnabledPlugins.Contains(p.UniqueId))
            .ToList()
            .AsReadOnly();

        var context = new PluginContext { Project = project };
        var tasks = allPlugins.Select(p => p.OnProjectChangedAsync(context));
        await Task.WhenAll(tasks);
    }

    private void OnProjectChanged(ProjectConfig project)
    {
        InvokeAsync(async () =>
        {
            await ApplyProjectAsync(project);
            StateHasChanged();
        });
    }

    private void ToggleTimeReport()
    {
        _showTimeReport = !_showTimeReport;
    }

    private void CloseTimeReport()
    {
        _showTimeReport = false;
    }

    private void CloseTerminal()
    {
        _showTerminal = false;
    }

    private async Task HandleActionClicked(ActionConfig action)
    {
        try
        {
            if (action.ActionType == ActionType.Script)
            {
                _showTerminal = true;
                StateHasChanged();
                await Task.Yield();
                if (_terminalOutput != null)
                {
                    await _terminalOutput.RunScript(ScriptService, action.Interpreter ?? "pwsh", action.ProcessPath, action.Arguments);
                }
                return;
            }

            if (!string.IsNullOrEmpty(action.WindowTitleRegex))
            {
                if (!ProcessService.FocusWindowByTitle(action.WindowTitleRegex))
                {
                    await ProcessService.StartProcessAsync(action.ProcessPath, action.Arguments);
                }
            }
            else
            {
                await ProcessService.StartProcessAsync(action.ProcessPath, action.Arguments);
            }
            NotificationService.ShowSuccess($"Launched {action.Label}", "Action");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Failed to launch {action.Label}: {ex.Message}", "Error");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_overflowModule != null)
        {
            try
            {
                await _overflowModule.InvokeVoidAsync("unobserve", _shell);
                await _overflowModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // Circuit already gone.
            }
        }
        _self?.Dispose();
        SettingsService.OnActiveProjectChanged -= OnProjectChanged;
        _layout.Changed -= OnPluginStateChanged;
        _dismiss.DismissRequested -= OnDismissRequested;
        ThemeService.OnThemeChanged -= OnThemeChanged;
        TimeTrackingService.OnTrackingChanged -= OnPluginStateChanged;
        foreach (var plugin in _subscribedPlugins)
        {
            plugin.OnStateChanged -= OnPluginStateChanged;
        }
        _clockTimer?.Dispose();
    }

    private static string FormatTime(TimeSpan ts) =>
        $"{(int)ts.TotalHours:D2}:{ts.Minutes:D2}";
}
